# ────────────────────────────────────────────────────────────
# Fan Engage — environment variables
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored. Never commit real secrets.
# ────────────────────────────────────────────────────────────

# Twilio — SMS confirmation on onboarding
# The API route prefers MESSAGING_SERVICE_SID when both are set.
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_MESSAGING_SERVICE_SID=MGXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_DEFAULT_FROM=+16155550123

# Supabase — auth + data
# Use NEXT_PUBLIC_* values in the browser; keep the service role key server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mailchimp — email list capture from onboarding
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=
MAILCHIMP_AUDIENCE_ID=

# Public origin — baked into the client at build time. Production must be
# https://www.fanengagepro.com (www + https). Do not set this to VERCEL_URL,
# https://fan-engage-pearl.vercel.app, or the apex https://fanengagepro.com;
# those leak into emailRedirectTo and GoTrue /verify redirect_to.
NEXT_PUBLIC_APP_URL=https://www.fanengagepro.com

# Site URL — used for CORS headers and UTM link generation
NEXT_PUBLIC_SITE_URL=https://www.fanengagepro.com

# Cloudflare Turnstile — bot protection on signup, magic-link, and forgot-password.
# Password sign-in does NOT use Turnstile (primary door stays captcha-free).
# Create a site at https://dash.cloudflare.com/?to=/:account/turnstile
# Widget type: Managed.
#
# Hostnames (Cloudflare Turnstile widget settings — required or the iframe
# paints but never issues a token, which used to leave Create account grey):
#   Production:  www.fanengagepro.com
#   Apex alias:  fanengagepro.com  (middleware 308s to www; still add it)
#   Preview:     *.vercel.app  (or each preview host) — Preview env in Vercel
#                must have its own NEXT_PUBLIC_TURNSTILE_SITE_KEY if the
#                Production widget does not allow *.vercel.app.
#
# Vercel Production + Preview both need:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY  (baked into the client at build time)
#   TURNSTILE_SECRET_KEY            (server /api/turnstile/verify)
# Pair must be from the same Cloudflare Turnstile site. A preview site key
# with a production secret (or the reverse) fails verify.
#
# If the widget never completes: Create account fail-opens after ~15s and
# shows Retry. Do not remove Turnstile to "fix" a hostname allowlist miss.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Magic-link / email-OTP login. Production is password-first until PKCE is
# proven (same-browser verify failed 2026-08-26). Do not set this true in
# Production. Preview/dev can omit it (CTA stays available there) or set
# false to hide. After PKCE works: NEXT_PUBLIC_MAGIC_LINK_ENABLED=true
# NEXT_PUBLIC_MAGIC_LINK_ENABLED=true

# Forgot-password email recovery is the same PKCE class. Production /login
# hides the link until recovery is proven. Do not set this true in
# Production. Preview/dev can omit it (link stays available there).
# NEXT_PUBLIC_FORGOT_PASSWORD_ENABLED=true

# Marketplace / merch catalog — OFF at soft launch (RaeLynn provider issues).
# Guest-facing /marketplace and merch CTAs show Coming soon until this is true.
# Set to true in Vercel when the shop is ready to open (~ops target: ~1 month).
# NEXT_PUBLIC_MARKETPLACE_LIVE=true

# Fail-open on Cloudflare upstream/network errors (default: on). Set to 0/false/off
# to hard-block auth when siteverify is unreachable. Missing tokens and real
# challenge failures still fail-closed whenever keys are configured.
TURNSTILE_FAIL_OPEN=
